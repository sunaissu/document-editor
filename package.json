{
  "name": "@sunaissu/document-editor",
  "version": "1.1.0-rc.1",
  "description": "A portable React document editor with visual editing, Markdown source, and preview modes.",
  "keywords": [
    "react",
    "markdown",
    "document",
    "editor",
    "preview"
  ],
  "homepage": "https://github.com/sunaissu/document-editor#readme",
  "bugs": {
    "url": "https://github.com/sunaissu/document-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunaissu/document-editor.git"
  },
  "license": "MIT",
  "author": "sunaissu",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./yjs": {
      "types": "./dist/yjs.d.ts",
      "import": "./dist/yjs.mjs",
      "require": "./dist/yjs.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "implementation-review.txt",
    "feature-backlog.txt",
    "RELEASE.txt"
  ],
  "scripts": {
    "build": "tsup ./src/index.tsx ./src/yjs.ts --format cjs,esm --dts --clean",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && npm run build && node --test",
    "playground": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build",
    "prepublishOnly": "npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "yjs": "^13.6.31"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "yjs": "^13.6.31"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "katex": "0.19.0",
    "markdown-it": "^14.3.1"
  }
}
